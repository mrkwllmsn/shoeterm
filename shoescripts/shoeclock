#!/usr/bin/env python3
"""shoeclock — a luxury analogue wristwatch drawn with foot's vector graphics.

A brushed-metal bezel, a guilloche-textured dial with a radial gradient, a
chapter ring of 60 ticks, roman or arabic numerals, tapered hands with soft
drop shadows, a date aperture at 3 o'clock and a high-beat sweeping seconds
hand.

  shoeclock              one frame at the cursor (banner-friendly)
  shoeclock live [N]     redraw in place, sweeping (default ~8 fps; q quits)

Font-size independent: queries the cell size via ESC[16t and sizes the canvas
to the window. stdlib only.

  SHOECLOCK_THEME=0..5   0 Midnight, 1 Rose Gold, 2 Emerald, 3 Graphite,
                         4 Ivory (classic), 5 Neon
  SHOECLOCK_CARD=1       paint the gradient backdrop inline too (live always does)
  SHOECLOCK_PLAIN=1      force the plain-text (ASCII dial) fallback
  SHOECLOCK_FORCE=1      force graphics (e.g. when piping)
  SHOECLOCK_SELFTEST=1   render one headless frame and report, for smoke tests
"""
import os, sys, time, math, select, termios, tty

# ---------- capability detection ----------
def graphics_ok():
    if os.environ.get("SHOECLOCK_PLAIN"): return False
    if os.environ.get("SHOECLOCK_FORCE"): return True
    if not sys.stdout.isatty(): return False
    return "foot" in os.environ.get("TERM", "")

# ---------- terminal queries ----------
def _query(seq, term_char):
    try:
        tfd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
    except OSError:
        return None
    old = termios.tcgetattr(tfd)
    try:
        tty.setraw(tfd)
        os.write(tfd, seq.encode())
        buf = b""
        while True:
            r, _, _ = select.select([tfd], [], [], 0.3)
            if not r: break
            c = os.read(tfd, 1)
            if not c: break
            buf += c
            if c == term_char.encode(): break
    finally:
        termios.tcsetattr(tfd, termios.TCSADRAIN, old)
        os.close(tfd)
    return buf.decode(errors="ignore")

def cell_size():
    s = _query("\033[16t", "t") or ""            # -> ESC[6;<h>;<w>t
    try:
        p = s.strip("\033[t").split(";")
        return int(p[2]), int(p[1])
    except Exception:
        return 8, 16

def term_cells():
    for f in (sys.stdout, sys.stdin):
        try:
            ts = os.get_terminal_size(f.fileno())
            if ts.columns > 0 and ts.lines > 0:
                return ts.columns, ts.lines
        except Exception:
            pass
    return 80, 24

# ---------- colour helpers ----------
def _rgb(c): return tuple(int(c[i:i+2], 16) for i in (1, 3, 5))
def _hex(r, g, b): return "#%02x%02x%02x" % (max(0,min(255,int(r))),
                                             max(0,min(255,int(g))),
                                             max(0,min(255,int(b))))
def mix(c0, c1, t):
    (r0,g0,b0), (r1,g1,b1) = _rgb(c0), _rgb(c1)
    return _hex(r0+(r1-r0)*t, g0+(g1-g0)*t, b0+(b1-b0)*t)
def lighten(c, t): return mix(c, "#ffffff", t)
def darken(c, t):  return mix(c, "#000000", t)
def alpha(c, a):   return c + "%02x" % max(0, min(255, int(a)))

